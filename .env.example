# Template only. Do not place real secret values in this file or Git.
# The actual database DSN and token pepper must be mounted as private files.
BRAIN_ENVIRONMENT=development
BRAIN_BIND_HOST=127.0.0.1
BRAIN_PUBLISHED_HOST=
BRAIN_CONTAINERIZED=false
BRAIN_BIND_PORT=18081
BRAIN_DATA_ROOT=/absolute/path/to/personal-brain-v1-data
BRAIN_DATABASE_DSN_FILE=/absolute/path/to/private/database-dsn
BRAIN_DB_PASSWORD_FILE=/absolute/path/to/private/database-password
BRAIN_TOKEN_PEPPER_FILE=/absolute/path/to/private/token-pepper
BRAIN_DEFAULT_TIMEZONE=Asia/Shanghai
BRAIN_DEFAULT_CURRENCY=CNY
BRAIN_EXTERNAL_MODELS_ENABLED=false
BRAIN_MODEL_API_KEY_FILE=/run/secrets/model_api_key
BRAIN_CHAT_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
BRAIN_CHAT_MODEL_NAME=deepseek-v4.1-flash
BRAIN_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
BRAIN_EMBEDDING_MODEL_NAME=doubao-embedding-vision
BRAIN_EMBEDDING_DIMENSIONS=1024
BRAIN_MODEL_PROXY_SOCKET=/run/model-proxy/ark.sock
